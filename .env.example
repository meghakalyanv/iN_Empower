# ─────────────────────────────────────────────────
# iN Empower Website — settings
# Copy this file to .env and fill in the values, then run `npm run build`.
# Vite only exposes variables that start with VITE_ to the website.
# ─────────────────────────────────────────────────

# "supabase" = real backend (USE THIS FOR THE LIVE SITE)
# "mock"     = offline demo mode for development — nothing is saved anywhere
VITE_API_PROVIDER=supabase

# Supabase → Project Settings → API  (the anon/public key is safe to put here;
# NEVER put the service_role key in this file)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App Info
VITE_APP_NAME=iN Empower
VITE_APP_VERSION=1.0.0
